{
  "name": "rpg-pack",
  "version": "1.6.0",
  "description": "Juego RPG de ruta (estilo Slay the Spire) extraído de Easy Hit. Solo atributos básicos: ATK / HP.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "python -m http.server 8770 --bind 127.0.0.1",
    "test:engine": "node tests/rpg-sim.mjs",
    "test:events": "node tests/events-sim.mjs",
    "test:items": "node tests/items-sim.mjs",
    "test:meta": "node tests/meta-sim.mjs",
    "test:stats": "node tests/stats-sim.mjs",
    "release": "node tools/version.mjs",
    "test:version": "node tests/version-check.mjs",
    "test:save": "node tests/save-sim.mjs",
    "test:balance": "node tests/balance-guard.mjs",
    "balance": "node tools/balance.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "test": "npm run test:core && node tests/browser.test.mjs",
    "test:core": "node tests/version-check.mjs && node tests/rpg-sim.mjs && node tests/events-sim.mjs && node tests/items-sim.mjs && node tests/meta-sim.mjs && node tests/stats-sim.mjs && node tests/save-sim.mjs && node tests/balance-guard.mjs && node tests/sprites-sim.mjs",
    "build:site": "node tools/build-site.mjs",
    "sprites": "node tools/sprites.mjs",
    "test:sprites": "node tests/sprites-sim.mjs",
    "generate": "node tools/image-generator/cli.mjs"
  },
  "devDependencies": {
    "@google/genai": "^2.25.0",
    "playwright": "^1.60.0",
    "sharp": "^0.35.5"
  }
}
